rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Funções Auxiliares
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Garante que TODOS os campos obrigatórios existem e NENHUM campo estranho foi enviado
    function isValidProfileData() {
      return request.resource.data.keys().hasAll(['fullName', 'username', 'email', 'routineFocus'])
        && request.resource.data.keys().hasOnly(['fullName', 'username', 'email', 'routineFocus', 'theme']);
    }
    
    // Garante que o formulário só contém chaves permitidas da lista
    function isValidFormularioData() {
      return request.resource.data.keys().hasOnly([
        'rotina_diaria', 'horas_sono', 'carga_trabalho', 'estresse', 
        'equilibrio', 'atividades_fisicas', 'bem_estar_mental', 'objetivos'
      ]);
    }

    // Coleção Profiles - usuários só leem/escrevem seu próprio perfil
    match /profiles/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidProfileData();
    }

    // Coleção Formularios
    match /formularios/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidFormularioData();
    }

    // Progresso/Status do usuário (Gamificação)
    match /userStats/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Conquistas/Badges Globais - apenas leitura para usuários logados
    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if false; // Apenas admin via painel/backend
    }

    // Conquistas do Usuário 
    match /userAchievements/{userId} {
      allow read: if isOwner(userId);
      // Mude para 'if isOwner(userId)' caso o seu JS do front-end precise liberar as medalhas:
      allow write: if false; 
    }

    // Bloqueia qualquer outra coleção não listada acima
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
