rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserData() {
      return request.resource.data.keys().hasOnly([
        'name', 'createdAt', 'garden', 'streakDays', 'longestStreak',
        'lastPracticeDate', 'history', 'fullName', 'username', 'email',
        'routineFocus', 'theme'
      ]);
    }

    function isValidProfileData() {
      return request.resource.data.keys().hasOnly([
        'fullName', 'username', 'email', 'routineFocus', 'theme', 'name'
      ]);
    }

    function isValidFormularioData() {
      return request.resource.data.keys().hasOnly([
        'rotina_diaria', 'horas_sono', 'carga_trabalho', 'foco_melhorar',
        'cuidados_mente', 'observacoes', 'promptCondensado', 'atualizadoEm',
        'estresse', 'equilibrio', 'atividades_fisicas', 'bem_estar_mental',
        'objetivos'
      ]);
    }

    // User-owned app data is stored in users/{uid} by app.js and perfil.js.
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserData();
    }

    // Profile and form documents are read by minha-rotina.js.
    match /profiles/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidProfileData();
    }

    match /forms/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidFormularioData();
    }

    // Legacy collection retained for existing formulario documents.
    match /formularios/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidFormularioData();
    }

    match /userStats/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /userAchievements/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
