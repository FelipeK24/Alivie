# The static frontend does not load .env files or use Vite.
# Its Firebase web configuration is in firebase.js. Firebase web config is
# visible to clients by design; restrict authorized domains and secure data
# access with Firebase Authentication and Firestore Rules.

# Optional legacy server setting. Set this in the process environment if
# server.js is used; the current frontend does not call that server.
# JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# NODE_ENV=development
# PORT=3000
